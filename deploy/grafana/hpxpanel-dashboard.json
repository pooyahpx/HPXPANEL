        {
          "expr": "hpxpanel_node_network_out_bytes_per_second",
          "legendFormat": "{{node_name}} out"
        }
      ],
      "title": "Node Network",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "hpxpanel_protocol_health",
          "legendFormat": "{{scope}}/{{node_id}}/{{protocol}}"
        }
      ],
      "title": "Protocol Health (1=healthy, 0.5=degraded, 0=down)",
      "type": "timeseries"
